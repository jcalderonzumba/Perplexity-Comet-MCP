{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-main.sh",
            "timeout": 10,
            "statusMessage": "Checking branch protection"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking review and preflight stamps"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["mcp__codegraph__*"]
  },
  "enabledMcpjsonServers": ["codegraph"]
}
